# Copie para .env e preencha. Nunca faça commit do .env.
DATABASE_URL="mysql://usuario:senha@host:3306/banco"

CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
CLOUDINARY_PASTA=classificadosdigitalbrasil

NEXT_PUBLIC_URL=http://localhost:3000

# Admin inicial (criado pelo seed só se ainda não houver admin)
SEED_ADMIN_EMAIL=
SEED_ADMIN_SENHA=
SEED_ADMIN_NOME=Administrador

# Pix automático (feature 006). Sem o token, vale o Pix estático com confirmação no painel.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# Aviso de mensagem por e-mail (feature 010). Sem RESEND_API_KEY e sem SMTP o aviso fica desligado.
# Caminho em uso: Resend. Só a chave é obrigatória; o remetente padrão é noreply@karollynemorais.com.br.
RESEND_API_KEY=
# Opcional: outro remetente de um domínio autenticado no Resend ("endereco@dominio" ou "Nome <endereco@dominio>").
EMAIL_FROM=

# Alternativa: outro servidor SMTP. Se SMTP_HOST, SMTP_USER ou SMTP_PASS existir, vale o SMTP e não o Resend.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=endereço completo, SMTP_PASS=senha de app.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
