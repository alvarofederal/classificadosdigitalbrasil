// prisma/schema.prisma — modelo de dados do Classificados Digitais do Brasil (spec/03-data-model.md)

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma" // sem FKs físicas → todo campo de relação tem @@index
}

// ─────────────────────────────────────────
// ACESSO (ADR-03: sessão própria em banco)
// ─────────────────────────────────────────

enum Perfil {
  ANUNCIANTE
  ADMIN
}

model Usuario {
  id                String    @id @default(cuid())
  nome              String    @db.VarChar(120)
  cpf               String?   @unique @db.Char(11) // obrigatório para anunciante (RN-02); admin inicial pode não ter
  email             String    @unique @db.VarChar(160)
  celular           String    @default("") @db.VarChar(11)
  uf                String    @default("") @db.Char(2)
  cidadeCodigo      Int       @default(0) // código IBGE do município
  senhaHash         String    @db.VarChar(100)
  perfil            Perfil    @default(ANUNCIANTE)
  ativo             Boolean   @default(true)
  deveTrocarSenha   Boolean   @default(false)
  aceitouTermosEm   DateTime?
  ultimoAcesso      DateTime?
  criadoEm          DateTime  @default(now())
  atualizadoEm      DateTime  @updatedAt
  // Feature 016: nulo enquanto o e-mail não foi confirmado pelo código (RF-150); as contas antigas vieram confirmadas (RN-154).
  emailConfirmadoEm DateTime?
  // RN-155: e-mail sem "+etiqueta" e, no Gmail, sem pontos. Calculado no repositório; sem UNIQUE para a migration nunca falhar.
  emailCanonico     String    @default("") @db.VarChar(160)
  // Feature 017 (ADR-21): saldo do banco de dias; o extrato fica em movimentos_do_banco (RN-178).
  bancoDiasSimples  Int       @default(0)
  bancoDiasFotos    Int       @default(0)
  presenteEm        DateTime? // RN-174: quando recebeu o presente de boas-vindas
  ipDoCadastro      String?   @db.VarChar(64) // RN-176: conexão de onde a conta foi criada

  sessoes         Sessao[]
  anuncios        Anuncio[]
  pagamentos      Pagamento[]        @relation("PagamentoDoUsuario")
  confirmados     Pagamento[]        @relation("PagamentoConfirmadoPor")
  codigosPorEmail CodigoPorEmail[]
  movimentos      MovimentoDoBanco[]
  convitesFeitos  Convite[]          @relation("ConvitesFeitos")
  conviteAceito   Convite?           @relation("ConviteAceito")

  @@index([criadoEm])
  @@index([emailCanonico])
  @@index([ipDoCadastro, criadoEm])
  @@map("usuarios")
}

// Feature 015 (ADR-22): convites de cortesia. O link leva um código; aqui fica só o hash dele (RN-256).
enum CanalDoConvite {
  EMAIL
  WHATSAPP
}

model Convite {
  id           String         @id @default(cuid())
  convidanteId String
  canal        CanalDoConvite
  emailDestino String?        @db.VarChar(160) // só no convite por e-mail (RN-252)
  codigoHash   String         @unique @db.Char(64)
  criadoEm     DateTime       @default(now())
  expiraEm     DateTime
  aceitoPorId  String?        @unique // uma conta aceita no máximo um convite
  aceitoEm     DateTime?
  premiadoEm   DateTime? // RN-254: o prêmio de quem convidou saiu
  canceladoEm  DateTime?

  convidante Usuario  @relation("ConvitesFeitos", fields: [convidanteId], references: [id], onDelete: Cascade)
  aceitoPor  Usuario? @relation("ConviteAceito", fields: [aceitoPorId], references: [id])

  @@index([convidanteId, criadoEm])
  @@map("convites")
}

// Feature 017 (ADR-21): extrato do banco de dias. Positivo entra, negativo sai.
enum MotivoDoMovimento {
  BOAS_VINDAS
  USO
  DEVOLUCAO
  CONVITE
  COMPRA
  CORTESIA
}

model MovimentoDoBanco {
  id          String            @id @default(cuid())
  usuarioId   String
  planoCodigo String            @db.VarChar(20) // SIMPLES (sem foto) ou FOTOS (com foto)
  dias        Int
  motivo      MotivoDoMovimento
  anuncioId   String?
  pagamentoId String?
  criadoEm    DateTime          @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, criadoEm])
  @@map("movimentos_do_banco")
}

// Feature 016 (ADR-20): código de 6 números por e-mail. Só o hash fica aqui (RN-150).
enum FinalidadeDoCodigo {
  CADASTRO
  TROCA_DE_EMAIL
  NOVA_SENHA
}

model CodigoPorEmail {
  id          String             @id @default(cuid())
  usuarioId   String
  finalidade  FinalidadeDoCodigo
  email       String             @db.VarChar(160) // para onde foi: o da conta, ou o novo na troca
  codigoHash  String             @db.Char(64)
  tentativas  Int                @default(0)
  expiraEm    DateTime
  encerradoEm DateTime? // usado, ou invalidado por um código mais novo
  criadoEm    DateTime           @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, finalidade, criadoEm])
  @@map("codigos_por_email")
}

model Sessao {
  id        String   @id @default(cuid())
  usuarioId String
  tokenHash String   @unique @db.Char(64) // SHA-256 do token do cookie
  expiraEm  DateTime
  criadoEm  DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("sessoes")
}

model TentativaLogin {
  id       String   @id @default(cuid())
  email    String   @db.VarChar(160)
  ip       String   @db.VarChar(64)
  sucesso  Boolean
  criadoEm DateTime @default(now())

  @@index([ip, criadoEm])
  @@map("tentativas_login")
}

// ─────────────────────────────────────────
// CADERNO
// ─────────────────────────────────────────

model Categoria {
  id       String   @id @default(cuid())
  nome     String   @db.VarChar(60)
  slug     String   @unique @db.VarChar(70)
  ordem    Int      @default(0)
  ativa    Boolean  @default(true)
  criadoEm DateTime @default(now())

  anuncios Anuncio[]

  @@index([ordem])
  @@map("categorias")
}

enum SituacaoAnuncio {
  AGUARDANDO_PAGAMENTO
  PUBLICADO
  DESATIVADO // feature 014: fora do caderno a pedido do dono; o prazo continua correndo (RN-141)
  REMOVIDO
}

// Feature 021: a resposta do dono ao "Fechou negócio?".
enum ResultadoDoAnuncio {
  PELO_CLASSIFICADOS
  POR_OUTRO_LUGAR
  AINDA_NAO
}

enum Moldura {
  NENHUMA
  SIMPLES
  DUPLA
  TRACEJADA
}

enum EstiloTitulo {
  NEGRITO
  TARJA
  SUBLINHADO
}

enum Alinhamento {
  ESQUERDA
  CENTRO
}

model Anuncio {
  id                    String              @id @default(cuid())
  codigo                String              @unique @db.Char(6) // endereço público /anuncio/<codigo>
  usuarioId             String
  categoriaId           String
  uf                    String              @db.Char(2)
  cidadeCodigo          Int
  titulo                String              @db.VarChar(40)
  texto                 String              @db.VarChar(400)
  preco                 Decimal?            @db.Decimal(12, 2)
  moldura               Moldura             @default(SIMPLES)
  estiloTitulo          EstiloTitulo        @default(NEGRITO)
  alinhamento           Alinhamento         @default(ESQUERDA)
  estrelas              Boolean             @default(false)
  situacao              SituacaoAnuncio     @default(AGUARDANDO_PAGAMENTO)
  planoCodigo           String              @default("SIMPLES") @db.VarChar(20) // plano escolhido / em vigor (feature 003)
  prioridade            Int                 @default(0) // RN-50: definida quando o pagamento é confirmado
  visualizacoes         Int                 @default(0) // RF-75: total de visitas; por dia, pessoa e cidade em visitas_anuncio (feature 013)
  publicadoEm           DateTime?
  expiraEm              DateTime?
  avisoDeVencimentoPara DateTime? // feature 012 (RN-120): o fim de prazo que já teve aviso por e-mail
  resultado             ResultadoDoAnuncio? // feature 021 (RN-211): "Fechou negócio?"; nulo = sem resposta
  resultadoEm           DateTime?
  criadoEm              DateTime            @default(now())
  atualizadoEm          DateTime            @updatedAt

  usuario    Usuario         @relation(fields: [usuarioId], references: [id])
  categoria  Categoria       @relation(fields: [categoriaId], references: [id])
  fotos      FotoAnuncio[]
  mensagens  Mensagem[]
  pagamentos Pagamento[]
  visitas    VisitaAnuncio[]

  // RNF-01: a lista pública é sempre de UMA cidade + UMA categoria, só o que está no ar.
  @@index([cidadeCodigo, categoriaId, situacao, expiraEm])
  @@index([planoCodigo, situacao, expiraEm]) // vitrine da capa (RF-47)
  @@index([situacao, expiraEm]) // aviso de vencimento (feature 012): anúncios no ar que saem na janela
  @@index([usuarioId])
  @@index([categoriaId])
  @@index([uf, cidadeCodigo])
  @@index([criadoEm])
  @@map("anuncios")
}

model FotoAnuncio {
  id        String   @id @default(cuid())
  anuncioId String
  url       String   @db.VarChar(500)
  publicId  String   @db.VarChar(255)
  ordem     Int      @default(0)
  criadoEm  DateTime @default(now())

  anuncio Anuncio @relation(fields: [anuncioId], references: [id], onDelete: Cascade)

  @@index([anuncioId, ordem])
  @@map("fotos_anuncio")
}

model Mensagem {
  id        String   @id @default(cuid())
  anuncioId String
  nome      String   @db.VarChar(80)
  contato   String   @db.VarChar(120)
  texto     String   @db.Text
  lida      Boolean  @default(false)
  criadoEm  DateTime @default(now())

  anuncio Anuncio @relation(fields: [anuncioId], references: [id], onDelete: Cascade)

  @@index([anuncioId, criadoEm])
  @@map("mensagens")
}

/// Feature 013 (ADR-18): uma linha por anúncio, dia (de Brasília) e pessoa. Sem IP: a pessoa é um HMAC do anúncio,
/// do IP e do navegador (RN-131). Cidade, UF e país são os aproximados da conexão (RN-132).
model VisitaAnuncio {
  anuncioId String
  dia       DateTime @db.Date
  chave     String   @db.Char(64)
  vezes     Int      @default(1) // RN-134: no máximo 20 por pessoa no dia
  cidade    String?  @db.VarChar(80)
  uf        String?  @db.Char(2)
  pais      String?  @db.Char(2)

  anuncio Anuncio @relation(fields: [anuncioId], references: [id], onDelete: Cascade)

  @@id([anuncioId, dia, chave])
  @@map("visitas_anuncio")
}

// ─────────────────────────────────────────
// PLANOS E PAGAMENTO (feature 003; ADR-07 Pix estático; ADR-12 gateway)
// ─────────────────────────────────────────

model Plano {
  codigo       String   @id @db.VarChar(20) // SIMPLES, FOTOS, DESTAQUE, VITRINE (fixos, RN-55)
  nome         String   @db.VarChar(40)
  descricao    String   @db.VarChar(200)
  maxFotos     Int
  ativo        Boolean  @default(true)
  atualizadoEm DateTime @updatedAt

  precos Preco[]

  @@map("planos")
}

// Feature 009 (RN-56): um preço por plano e período (7, 10, 15, 20, 30 dias).
model Preco {
  planoCodigo String  @db.VarChar(20)
  dias        Int
  valor       Decimal @db.Decimal(10, 2)

  plano Plano @relation(fields: [planoCodigo], references: [codigo], onDelete: Cascade)

  @@id([planoCodigo, dias])
  @@map("precos")
}

enum SituacaoPagamento {
  PENDENTE
  CONFIRMADO
  CANCELADO
}

model Pagamento {
  id              String            @id @default(cuid())
  codigo          String            @unique @db.Char(10) // identificador que vai no Pix
  anuncioId       String
  usuarioId       String
  valor           Decimal           @db.Decimal(10, 2)
  dias            Int
  planoCodigo     String            @default("SIMPLES") @db.VarChar(20)
  situacao        SituacaoPagamento @default(PENDENTE)
  gateway         String?           @db.VarChar(20) // MERCADO_PAGO, CORTESIA ou nulo (Pix estático)
  gatewayId       String?           @db.VarChar(64)
  copiaECola      String?           @db.Text // Pix dinâmico devolvido pelo gateway
  vencimentoEm    DateTime?
  criadoEm        DateTime          @default(now())
  confirmadoEm    DateTime?
  confirmadoPorId String?

  anuncio       Anuncio  @relation(fields: [anuncioId], references: [id])
  usuario       Usuario  @relation("PagamentoDoUsuario", fields: [usuarioId], references: [id])
  confirmadoPor Usuario? @relation("PagamentoConfirmadoPor", fields: [confirmadoPorId], references: [id])

  @@index([anuncioId, situacao])
  @@index([usuarioId, situacao])
  @@index([confirmadoPorId])
  @@index([situacao, criadoEm])
  @@index([gatewayId])
  @@map("pagamentos")
}

// Recebedor do Pix estático (reserva quando o gateway não está configurado).
model Configuracao {
  id              String   @id @default("geral")
  pixChave        String   @default("") @db.VarChar(77)
  pixNome         String   @default("") @db.VarChar(25)
  pixCidade       String   @default("") @db.VarChar(15)
  presenteLigado  Boolean  @default(true) // feature 017 (RF-174): presente de boas-vindas
  convitesLigados Boolean  @default(true) // feature 015 (RF-256): convites
  atualizadoEm    DateTime @updatedAt

  @@map("configuracoes")
}

// ─────────────────────────────────────────
// CONTATO (feature 004)
// ─────────────────────────────────────────

enum AssuntoChamado {
  DUVIDA
  SUPORTE
  PAGAMENTO
  DENUNCIA
  SUGESTAO
  OUTRO
}

enum SituacaoChamado {
  ABERTO
  RESOLVIDO
}

model Chamado {
  id            String          @id @default(cuid())
  protocolo     String          @unique @db.Char(8)
  nome          String          @db.VarChar(80)
  email         String          @db.VarChar(160)
  telefone      String          @default("") @db.VarChar(20)
  assunto       AssuntoChamado
  mensagem      String          @db.Text
  anuncioCodigo String?         @db.Char(6)
  situacao      SituacaoChamado @default(ABERTO)
  notaInterna   String?         @db.Text
  criadoEm      DateTime        @default(now())
  resolvidoEm   DateTime?

  @@index([situacao, criadoEm])
  @@index([email, criadoEm])
  @@map("chamados")
}
