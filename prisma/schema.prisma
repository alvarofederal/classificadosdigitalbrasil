// prisma/schema.prisma — modelo de dados do Classificados Digitais do Brasil (spec/03-data-model.md)

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma" // sem FKs físicas → todo campo de relação tem @@index
}

// ─────────────────────────────────────────
// ACESSO (ADR-03: sessão própria em banco)
// ─────────────────────────────────────────

enum Perfil {
  ANUNCIANTE
  ADMIN
}

model Usuario {
  id              String    @id @default(cuid())
  nome            String    @db.VarChar(120)
  cpf             String?   @unique @db.Char(11) // obrigatório para anunciante (RN-02); admin inicial pode não ter
  email           String    @unique @db.VarChar(160)
  celular         String    @default("") @db.VarChar(11)
  uf              String    @default("") @db.Char(2)
  cidadeCodigo    Int       @default(0) // código IBGE do município
  senhaHash       String    @db.VarChar(100)
  perfil          Perfil    @default(ANUNCIANTE)
  ativo           Boolean   @default(true)
  deveTrocarSenha Boolean   @default(false)
  aceitouTermosEm DateTime?
  ultimoAcesso    DateTime?
  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt

  sessoes     Sessao[]
  anuncios    Anuncio[]
  pagamentos  Pagamento[] @relation("PagamentoDoUsuario")
  confirmados Pagamento[] @relation("PagamentoConfirmadoPor")

  @@index([criadoEm])
  @@map("usuarios")
}

model Sessao {
  id        String   @id @default(cuid())
  usuarioId String
  tokenHash String   @unique @db.Char(64) // SHA-256 do token do cookie
  expiraEm  DateTime
  criadoEm  DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("sessoes")
}

model TentativaLogin {
  id       String   @id @default(cuid())
  email    String   @db.VarChar(160)
  ip       String   @db.VarChar(64)
  sucesso  Boolean
  criadoEm DateTime @default(now())

  @@index([ip, criadoEm])
  @@map("tentativas_login")
}

// ─────────────────────────────────────────
// CADERNO
// ─────────────────────────────────────────

model Categoria {
  id       String   @id @default(cuid())
  nome     String   @db.VarChar(60)
  slug     String   @unique @db.VarChar(70)
  ordem    Int      @default(0)
  ativa    Boolean  @default(true)
  criadoEm DateTime @default(now())

  anuncios Anuncio[]

  @@index([ordem])
  @@map("categorias")
}

enum SituacaoAnuncio {
  AGUARDANDO_PAGAMENTO
  PUBLICADO
  REMOVIDO
}

enum Moldura {
  NENHUMA
  SIMPLES
  DUPLA
  TRACEJADA
}

enum EstiloTitulo {
  NEGRITO
  TARJA
  SUBLINHADO
}

enum Alinhamento {
  ESQUERDA
  CENTRO
}

model Anuncio {
  id            String          @id @default(cuid())
  codigo        String          @unique @db.Char(6) // endereço público /anuncio/<codigo>
  usuarioId     String
  categoriaId   String
  uf            String          @db.Char(2)
  cidadeCodigo  Int
  titulo        String          @db.VarChar(40)
  texto         String          @db.VarChar(400)
  preco         Decimal?        @db.Decimal(12, 2)
  moldura       Moldura         @default(SIMPLES)
  estiloTitulo  EstiloTitulo    @default(NEGRITO)
  alinhamento   Alinhamento     @default(ESQUERDA)
  estrelas      Boolean         @default(false)
  situacao      SituacaoAnuncio @default(AGUARDANDO_PAGAMENTO)
  planoCodigo   String          @default("SIMPLES") @db.VarChar(20) // plano escolhido / em vigor (feature 003)
  prioridade    Int             @default(0) // RN-50: definida quando o pagamento é confirmado
  visualizacoes Int             @default(0) // RF-75, sem dados de quem visitou
  publicadoEm   DateTime?
  expiraEm      DateTime?
  criadoEm      DateTime        @default(now())
  atualizadoEm  DateTime        @updatedAt

  usuario    Usuario       @relation(fields: [usuarioId], references: [id])
  categoria  Categoria     @relation(fields: [categoriaId], references: [id])
  fotos      FotoAnuncio[]
  mensagens  Mensagem[]
  pagamentos Pagamento[]

  // RNF-01: a lista pública é sempre de UMA cidade + UMA categoria, só o que está no ar.
  @@index([cidadeCodigo, categoriaId, situacao, expiraEm])
  @@index([planoCodigo, situacao, expiraEm]) // vitrine da capa (RF-47)
  @@index([usuarioId])
  @@index([categoriaId])
  @@index([uf, cidadeCodigo])
  @@index([criadoEm])
  @@map("anuncios")
}

model FotoAnuncio {
  id        String   @id @default(cuid())
  anuncioId String
  url       String   @db.VarChar(500)
  publicId  String   @db.VarChar(255)
  ordem     Int      @default(0)
  criadoEm  DateTime @default(now())

  anuncio Anuncio @relation(fields: [anuncioId], references: [id], onDelete: Cascade)

  @@index([anuncioId, ordem])
  @@map("fotos_anuncio")
}

model Mensagem {
  id        String   @id @default(cuid())
  anuncioId String
  nome      String   @db.VarChar(80)
  contato   String   @db.VarChar(120)
  texto     String   @db.Text
  lida      Boolean  @default(false)
  criadoEm  DateTime @default(now())

  anuncio Anuncio @relation(fields: [anuncioId], references: [id], onDelete: Cascade)

  @@index([anuncioId, criadoEm])
  @@map("mensagens")
}

// ─────────────────────────────────────────
// PLANOS E PAGAMENTO (feature 003; ADR-07 Pix estático; ADR-12 gateway)
// ─────────────────────────────────────────

model Plano {
  codigo       String   @id @db.VarChar(20) // SIMPLES, FOTOS, DESTAQUE, VITRINE (fixos, RN-55)
  nome         String   @db.VarChar(40)
  descricao    String   @db.VarChar(200)
  maxFotos     Int
  valor7Dias   Decimal  @db.Decimal(10, 2)
  valor30Dias  Decimal  @db.Decimal(10, 2)
  ativo        Boolean  @default(true)
  atualizadoEm DateTime @updatedAt

  @@map("planos")
}

enum SituacaoPagamento {
  PENDENTE
  CONFIRMADO
  CANCELADO
}

model Pagamento {
  id              String            @id @default(cuid())
  codigo          String            @unique @db.Char(10) // identificador que vai no Pix
  anuncioId       String
  usuarioId       String
  valor           Decimal           @db.Decimal(10, 2)
  dias            Int
  planoCodigo     String            @default("SIMPLES") @db.VarChar(20)
  situacao        SituacaoPagamento @default(PENDENTE)
  gateway         String?           @db.VarChar(20) // MERCADO_PAGO, CORTESIA ou nulo (Pix estático)
  gatewayId       String?           @db.VarChar(64)
  copiaECola      String?           @db.Text // Pix dinâmico devolvido pelo gateway
  vencimentoEm    DateTime?
  criadoEm        DateTime          @default(now())
  confirmadoEm    DateTime?
  confirmadoPorId String?

  anuncio       Anuncio  @relation(fields: [anuncioId], references: [id])
  usuario       Usuario  @relation("PagamentoDoUsuario", fields: [usuarioId], references: [id])
  confirmadoPor Usuario? @relation("PagamentoConfirmadoPor", fields: [confirmadoPorId], references: [id])

  @@index([anuncioId, situacao])
  @@index([usuarioId, situacao])
  @@index([confirmadoPorId])
  @@index([situacao, criadoEm])
  @@index([gatewayId])
  @@map("pagamentos")
}

// Recebedor do Pix estático (reserva quando o gateway não está configurado).
model Configuracao {
  id           String   @id @default("geral")
  pixChave     String   @default("") @db.VarChar(77)
  pixNome      String   @default("") @db.VarChar(25)
  pixCidade    String   @default("") @db.VarChar(15)
  atualizadoEm DateTime @updatedAt

  @@map("configuracoes")
}

// ─────────────────────────────────────────
// CONTATO (feature 004)
// ─────────────────────────────────────────

enum AssuntoChamado {
  DUVIDA
  SUPORTE
  PAGAMENTO
  DENUNCIA
  SUGESTAO
  OUTRO
}

enum SituacaoChamado {
  ABERTO
  RESOLVIDO
}

model Chamado {
  id            String          @id @default(cuid())
  protocolo     String          @unique @db.Char(8)
  nome          String          @db.VarChar(80)
  email         String          @db.VarChar(160)
  telefone      String          @default("") @db.VarChar(20)
  assunto       AssuntoChamado
  mensagem      String          @db.Text
  anuncioCodigo String?         @db.Char(6)
  situacao      SituacaoChamado @default(ABERTO)
  notaInterna   String?         @db.Text
  criadoEm      DateTime        @default(now())
  resolvidoEm   DateTime?

  @@index([situacao, criadoEm])
  @@index([email, criadoEm])
  @@map("chamados")
}
